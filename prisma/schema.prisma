generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String   @id @default(cuid())
  title          String
  description    String?  @db.Text // supports \n newlines
  price          Float
  oldPrice       Float?
  sale           Boolean  @default(false)

  stock          Int      @default(1)     // number of items available, 0 = sold out
  madeToOrder    Boolean  @default(false) // if true, stock is ignored
  personalizable Boolean  @default(false) // customer can request a name on the item

  type           String   // "Svečniki", "Okraski za smrečico", ...
  occasions      String[] // ["Božič"]
  woods          String[] // ["Bukev", "Hrast"]
  colors         String[] // ["Naravna", "Rdeča"]
  candleType     String?  // only for "Svečniki"

  heightCm       Float?
  widthCm        Float?
  depthCm        Float?
  diameterCm     Float?   // for round items, instead of width/depth

  images         ProductImage[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([stock])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  position   Int      @default(0) // 0 = cover image
  alt        String?

  path       String   // "/uploads/products/<productId>/<id>.webp" (large, max ~1600 px)
  thumbPath  String   // "/uploads/products/<productId>/<id>-thumb.webp" (~400 px)
  width      Int?
  height     Int?

  createdAt  DateTime @default(now())

  @@index([productId, position])
}